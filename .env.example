DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_TTL="1h"
REFRESH_TOKEN_TTL="7d"

# Grading: "gemma" (default, needs the gemma/ service running) or "stub" (offline)
GRADING_BACKEND="gemma"
GEMMA_BATCH_URL="http://127.0.0.1:8000/v1/decide/batch"

# Read by the gemma/ service (it loads this same file). Get a key at
# https://aistudio.google.com/apikey. Optional: GEMMA_MODEL="gemma-4-31b-it"
GEMINI_API_KEY=""
