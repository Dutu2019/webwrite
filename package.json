{
  "name": "webwrite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prisma-generate.mjs",
    "predev": "node scripts/prisma-generate.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prisma-generate.mjs && node scripts/prisma-migrate.mjs",
    "build": "next build",
    "start": "next start",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "node scripts/db-check.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "katex": "0.19.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "^5.7.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.29",
    "deepmerge-ts": "8.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
